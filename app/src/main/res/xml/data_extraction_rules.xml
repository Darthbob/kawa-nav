<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's backup and the phone-to-phone transfer may take: the rides, the refuels, the battery
  readings, the maintenance log, the settings and the bike's last values, so they move to a new phone.
  Offline maps (large, downloaded again), the log, icon caches and other files stay on the phone. The
  cloud backup only runs end-to-end encrypted (the phone has a screen lock); otherwise the rides' GPS
  tracks are not backed up at all.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="rides/" />
        <include domain="file" path="bike.json" />
        <include domain="file" path="fuel.json" />
        <include domain="file" path="battery.json" />
        <include domain="file" path="maintenance.json" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rides/" />
        <include domain="file" path="bike.json" />
        <include domain="file" path="fuel.json" />
        <include domain="file" path="battery.json" />
        <include domain="file" path="maintenance.json" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
